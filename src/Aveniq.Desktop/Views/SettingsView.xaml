<UserControl x:Class="Aveniq.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="96" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,9" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Network -->
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Network" Style="{StaticResource H2}" Margin="0,0,0,2" />
                        <TextBlock Text="How much of your connection Aveniq may use." Style="{StaticResource Caption}" Margin="0,0,0,5" />

                        <Border Style="{StaticResource SettingRow}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Internet download speed" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Text="Used to budget prefetch and estimate download time." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Text="{Binding DeclaredMbps, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingField}" />
                                        <TextBlock Text="Mbps" Style="{StaticResource Caption}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Measured}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Share for background prefetch" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Largest part of the link speculative reads may use." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding BackgroundShare, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingField}" />
                                    <TextBlock Text="%" Style="{StaticResource Caption}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Hard bandwidth limit" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Caps rclone. Use 0 for no limit." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding HardLimitMbps, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingField}" />
                                    <TextBlock Text="Mbps" Style="{StaticResource Caption}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Provider requests per second" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Protects Google Drive API quotas." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding TpsLimit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingField}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Parallel prefetch requests" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Upper bound for speculative reads." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding MaxConcurrency, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingField}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Prediction -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Prediction engine" Style="{StaticResource H2}" Margin="0,0,0,2" />
                        <TextBlock Text="What Aveniq may read ahead, and when." Style="{StaticResource Caption}" Margin="0,0,0,5" />

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="Predictive prefetching" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Download what a game will need before it asks." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding PredictionEnabled}"
                                          Width="38" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="Record read telemetry" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Needed for profiles and hit/miss numbers." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding ReadProfiling}"
                                          Width="38" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Minimum prediction confidence" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Between 0.05 and 0.99." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding MinConfidence, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingField}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Prefetch budget per session" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Data fetched on a guess." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding SessionBudgetGb, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingField}" />
                                    <TextBlock Text="GB" Style="{StaticResource Caption}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   Text="A predictor whose accuracy stays below 25% after 64 checked blocks is disabled automatically for that game." />
                    </StackPanel>
                </Border>

                <!-- Startup and security -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Startup and security" Style="{StaticResource H2}" Margin="0,0,0,2" />
                        <TextBlock Text="How drives and credentials behave around the app." Style="{StaticResource Caption}" Margin="0,0,0,5" />

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="Restore drives when Aveniq starts" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Re-attach drives that were mounted at exit." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding RestoreMounts}"
                                          Width="38" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="Keep drives mounted after closing" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Used as the default answer in the close prompt." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding KeepMounts}"
                                          Width="38" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="Encrypt the rclone config" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="The key is protected with Windows DPAPI." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding EncryptConfig}"
                                          Width="38" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Local games folder" Style="{StaticResource Label}" Margin="0,10,0,3" />
                        <TextBlock Text="Hybrid and Full Local modes store copied files here." Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding LocalGamesRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <TextBlock Text="Data folder" Style="{StaticResource Label}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding DataRoot}" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Advanced rclone VFS -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Advanced · rclone VFS" Style="{StaticResource H2}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding RcloneInfo}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <TextBlock Text="Custom rclone path" Style="{StaticResource Label}" Margin="0,4,0,3" />
                        <TextBlock Text="Leave empty to use the bundled build." Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding RclonePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Buffer size" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="--buffer-size · memory read-ahead per file" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding BufferSize, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingField}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Read ahead" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="--vfs-read-ahead · extra on-disk read-ahead" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding ReadAhead, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingField}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Read chunk size" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="--vfs-read-chunk-size" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding ChunkSize, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingField}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Chunk streams" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="--vfs-read-chunk-streams · 0 = sequential" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding ChunkStreams, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingField}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Write-back delay" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Seconds after close before upload" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding WriteBackSeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingField}" />
                                    <TextBlock Text="s" Style="{StaticResource Caption}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,9,0,0"
                                   Text="Measured on this PC: with rclone's default 16 MiB buffer, three 64 KiB random reads downloaded tens of MiB; with 0 they downloaded 256 KiB. Aveniq defaults to 0 and lets the prediction engine decide what to read ahead." />
                    </StackPanel>
                </Border>

                <!-- Background & Startup -->
                <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Background &amp; Startup" Style="{StaticResource H2}" Margin="0,0,0,2" />
                        <TextBlock Text="Controls optional sign-in, notification-area and close behavior. Drives keep running while Aveniq is hidden."
                                   Style="{StaticResource Caption}" Margin="0,0,0,5" />

                        <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource BorderStrong}"
                                BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,5,0,7">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding EnableBackgroundFeatures}"
                                      AutomationProperties.Name="Enable background features"
                                      AutomationProperties.HelpText="Turns optional startup, notification-area and close behavior on or off. Saved choices below are kept.">
                                <StackPanel>
                                    <TextBlock Text="Enable background features" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="Controls optional startup and system-tray behavior. Your choices below are kept when this is off."
                                               Style="{StaticResource Caption}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <StackPanel IsEnabled="{Binding BackgroundControlsEnabled}">
                            <Border Style="{StaticResource SettingRow}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LaunchAtSignIn}"
                                          AutomationProperties.Name="Launch Aveniq at Windows sign-in"
                                          AutomationProperties.HelpText="Registers Aveniq for the current Windows user. It does not require administrator rights.">
                                    <StackPanel>
                                        <TextBlock Text="Launch Aveniq at Windows sign-in" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Text="Starts for this Windows user after sign-in. No administrator rights." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowTrayIcon}"
                                          AutomationProperties.Name="Enable system tray icon"
                                          AutomationProperties.HelpText="Shows the Aveniq icon in the Windows notification area.">
                                    <StackPanel>
                                        <TextBlock Text="Enable system tray icon" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Text="Keeps Aveniq reachable from the notification area." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray}"
                                          AutomationProperties.Name="Close to tray"
                                          AutomationProperties.HelpText="Hides the main window instead of exiting. Requires the tray icon.">
                                    <StackPanel>
                                        <TextBlock Text="Close to tray" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Text="Closing the window keeps Aveniq and its drives running. Requires the tray icon." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BackgroundNotifications}"
                                          AutomationProperties.Name="Background notifications"
                                          AutomationProperties.HelpText="Allows occasional status notices while Aveniq runs in the background.">
                                    <StackPanel>
                                        <TextBlock Text="Background notifications" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Text="Occasional notices when Aveniq is running in the background. Never routine file activity." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding BackgroundStatus}" Foreground="{Binding BackgroundStatusTone, Converter={StaticResource Tone}}"
                                   FontSize="11.5" LineHeight="17" TextWrapping="Wrap" Margin="0,10,0,0"
                                   AutomationProperties.Name="Background status"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
