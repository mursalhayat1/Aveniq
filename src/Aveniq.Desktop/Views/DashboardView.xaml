<UserControl x:Class="Aveniq.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Aveniq.Desktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,20">

            <!-- Real dependency/configuration warnings only. -->
            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,0,0,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardTight}" Margin="0,0,0,7"
                                BorderBrush="{Binding Tone, Converter={StaticResource Tone}}">
                            <DockPanel>
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding Tone, Converter={StaticResource Tone}}"
                                         Margin="0,0,10,0" />
                                <TextBlock TextWrapping="Wrap" FontSize="12">
                                    <Run Text="{Binding Key}" FontWeight="SemiBold" Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                                    <Run Text="{Binding Value}" Foreground="{StaticResource Muted}" />
                                </TextBlock>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Cache ledger + getting started -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="Measured live" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Cache storage" Style="{StaticResource H2}" Margin="0" />
                        </DockPanel>
                        <TextBlock Text="{Binding CacheUsage}" Style="{StaticResource Metric}"
                                   FontSize="23" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Value="{Binding CacheFraction}" Maximum="1" Margin="0,12,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="Aveniq cache" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Cyan}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CacheFree, StringFormat={}Free · {0}}" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Success}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CacheReserve, StringFormat={}Reserve · {0}}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </StackPanel>
                        <Border Style="{StaticResource Hairline}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding CacheDetail}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding FreeSpace}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Width="330" Margin="12,0,0,0" Padding="16,16,16,14"
                        Style="{StaticResource Card}" BorderBrush="{StaticResource BorderBrush}"
                        Visibility="{Binding SetupComplete, Converter={StaticResource NotVis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}">
                                <Run Text="{Binding SetupDone}" /><Run Text=" of " /><Run Text="{Binding SetupTotal}" /><Run Text=" done" />
                            </TextBlock>
                            <TextBlock Text="Get started" Style="{StaticResource H2}" Margin="0" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Setup}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xEA3A;" />
                                                    <Setter Property="Foreground" Value="{StaticResource Dim}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                                            <Setter Property="Text" Value="&#xE930;" />
                                                            <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Text}" FontSize="12.5" />
                                            <TextBlock Text="{Binding Hint}" FontSize="10.5" Foreground="{StaticResource Dim}"
                                                       TextWrapping="Wrap" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource Primary}" Content="Cloud drives" Padding="11,5"
                                    Command="{Binding GoCommand}" CommandParameter="Cloud Drives" />
                            <Button Content="Game library" Padding="11,5"
                                    Command="{Binding GoCommand}" CommandParameter="Game Library" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Live KPIs -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardTight}" Margin="0,0,9,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Connection health" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding Health}" Style="{StaticResource Metric}" FontSize="16"
                                   Foreground="{Binding HealthTone, Converter={StaticResource Tone}}" />
                        <TextBlock Text="From mounted drives" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardTight}" Margin="0,0,9,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Network throughput" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding TransferRate}" Style="{StaticResource Metric}" FontSize="16" />
                        <TextBlock Text="rclone, live" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardTight}" Margin="0,0,9,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Cache hit rate" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding HitRate}" Style="{StaticResource Metric}" FontSize="16" />
                        <TextBlock Text="This run" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardTight}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Prediction engine" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding EngineState}" Style="{StaticResource Metric}" FontSize="16"
                                   Foreground="{StaticResource Cyan}" />
                        <TextBlock Text="{Binding GameState}" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding GameState}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Throughput + right now -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.65*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,2">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TransferRate}" FontSize="11.5"
                                       Foreground="{StaticResource AccentHover}" FontFamily="{StaticResource MonoFont}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Network throughput" Style="{StaticResource H2}" Margin="0" />
                        </DockPanel>
                        <TextBlock Text="Last 2 minutes · reads through the virtual drives" Style="{StaticResource Caption}" />
                        <c:Sparkline Values="{Binding RateHistory}" Height="142" Stroke="{StaticResource Accent}"
                                     Capacity="120" EmptyText="No transfers yet" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding EngineDetail}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding EngineDetail}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Right now" Style="{StaticResource H2}" />
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Engine" Style="{StaticResource Caption}" Margin="0,6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EngineState}" FontSize="12"
                                       Foreground="{StaticResource Cyan}" Margin="12,6,0,6" />
                            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Hairline}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cache hit rate" Style="{StaticResource Caption}" Margin="0,6" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HitRate}" FontSize="12" Margin="12,6,0,6" />
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Hairline}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Cache on disk" Style="{StaticResource Caption}" Margin="0,6" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CacheUsage}" FontSize="12" Margin="12,6,0,6" />
                            <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Hairline}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Game" Style="{StaticResource Caption}" Margin="0,6" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GameState}" FontSize="12" Margin="12,6,0,6"
                                       TextTrimming="CharacterEllipsis" MaxWidth="150" ToolTip="{Binding GameState}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Accounts + drives -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Manage"
                                    Command="{Binding GoCommand}" CommandParameter="Cloud Drives" />
                            <TextBlock Text="Cloud accounts" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="No accounts connected." Style="{StaticResource Caption}" Margin="0,4,0,8"
                                   Visibility="{Binding Accounts.Count, Converter={StaticResource NotVis}}" />
                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Key}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource Muted}"
                                                   FontSize="11.5" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Add drive"
                                    Command="{Binding GoCommand}" CommandParameter="Cloud Drives" />
                            <TextBlock Text="Virtual drives" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="No drives configured." Style="{StaticResource Caption}" Margin="0,4,0,8"
                                   Visibility="{Binding Drives.Count, Converter={StaticResource NotVis}}" />
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5">
                                        <TextBlock Text="{Binding Key}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Value}" Foreground="{Binding Tone, Converter={StaticResource Tone}}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Style="{StaticResource Caption}" Margin="2,0,8,0"
                       Text="All figures are measured live from rclone and the Aveniq engine. Values without a real source are shown as 'Unavailable'. Uncached data always depends on your internet speed: at 70 Mbps the cloud delivers at most about 8.75 MB/s." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
