<Window x:Class="Aveniq.Desktop.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Aveniq" Width="700" Style="{StaticResource DialogWindow}"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="28,24,28,22">
        <StackPanel Orientation="Horizontal">
            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoft}"
                    BorderBrush="{StaticResource Accent}" BorderThickness="1">
                <Image Source="/Assets/aveniq.ico" Width="27" Height="27" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Aveniq" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="Bold" />
                <TextBlock Text="Cloud to SSD" FontSize="10" Foreground="{StaticResource Dim}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="Welcome to Aveniq" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                   FontWeight="SemiBold" Margin="0,20,0,3" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,16"
                   Text="Aveniq keeps your games in cloud storage and runs them on this PC, caching the parts they actually read on your SSD. It is not cloud gaming: your own CPU and GPU run the game, and uncached data arrives only as fast as your internet allows." />

        <TextBlock Text="Prerequisites" Style="{StaticResource H2}" />
        <Border Style="{StaticResource Panel}" Padding="12,10" Margin="0,0,0,14">
            <ItemsControl x:Name="Deps">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,4,10,0"
                                     Fill="{Binding Tone, Converter={StaticResource Tone}}" />
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="11.5">
                                <Run Text="{Binding Key}" FontWeight="SemiBold" />
                                <Run Text="{Binding Value}" Foreground="{StaticResource Muted}" />
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Text="Cache location" Style="{StaticResource H2}" />
        <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse" Margin="8,0,0,0" />
            <TextBox x:Name="CacheBox" TextChanged="CacheChanged" />
        </DockPanel>
        <TextBlock x:Name="CacheInfo" Style="{StaticResource Caption}" Margin="0,0,0,14" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Cache budget" Style="{StaticResource Label}" />
                <ComboBox x:Name="BudgetBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Keep free for Windows" Style="{StaticResource Label}" />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="GB" Style="{StaticResource Caption}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    <TextBox x:Name="ReserveBox" Text="8" />
                </DockPanel>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Internet speed" Style="{StaticResource Label}" />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="Mbps" Style="{StaticResource Caption}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    <TextBox x:Name="MbpsBox" Text="70" />
                </DockPanel>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="Estimate" Style="{StaticResource Caption}" Margin="0,12,0,0" />
        <TextBlock x:Name="Status" Style="{StaticResource Caption}" Foreground="{StaticResource Danger}" Margin="0,8,0,0" />

        <Border Style="{StaticResource Hairline}" Margin="0,16,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Primary}" Content="Save and continue" Click="Ok" />
            <Button Content="Later" Click="Later" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
