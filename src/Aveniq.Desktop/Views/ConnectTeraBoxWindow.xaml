<Window x:Class="Aveniq.Desktop.Views.ConnectTeraBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect TeraBox" Width="640" Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="26,22">
        <TextBlock Text="Connect TeraBox" Style="{StaticResource H1}" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14" TextWrapping="Wrap"
                   Text="This uses an unofficial community rclone backend, not a TeraBox-approved integration. It authenticates with a browser session cookie. Treat that cookie like your password; never share it. Aveniq stores it in a separate encrypted profile on this Windows account." />
        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Warning}" Background="{StaticResource Surface}" Padding="12,9" Margin="0,0,0,14">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Warning}"
                       Text="The backend uses undocumented TeraBox web endpoints and may stop working or cause account restrictions. Game compatibility and upload behavior have not been verified." />
        </Border>
        <TextBlock Text="Account name" Style="{StaticResource Label}" />
        <TextBox x:Name="NameBox" Margin="0,0,0,12" />
        <TextBlock Text="Browser session cookie" Style="{StaticResource Label}" />
        <PasswordBox x:Name="CookieBox" Margin="0,0,0,6" />
        <Button Content="Open authentication instructions" Style="{StaticResource Ghost}" HorizontalAlignment="Left"
                Padding="0,2" Click="OpenInstructions" />
        <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="0,14,0,0" Foreground="{StaticResource Accent}"
                   MaxHeight="100" TextWrapping="Wrap" />
        <ProgressBar x:Name="Progress" IsIndeterminate="True" Margin="0,8,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="ConnectButton" Style="{StaticResource Primary}" Content="Connect and verify access" Click="Connect" />
            <Button Content="Cancel" Click="Cancel" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
