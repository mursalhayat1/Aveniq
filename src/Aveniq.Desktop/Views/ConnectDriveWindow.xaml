<Window x:Class="Aveniq.Desktop.Views.ConnectDriveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Google Drive" Width="650" Style="{StaticResource DialogWindow}"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="26,22,26,20">
        <TextBlock Text="Connect Google Drive" Style="{StaticResource H1}" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,16"
                   Text="Sign in on Google's page in your browser. Aveniq never sees your Google password; your Google Drive appears as a drive letter in File Explorer." />

        <!-- Key status -->
        <Border x:Name="KeyFoundBox" Visibility="Collapsed" CornerRadius="8" BorderThickness="1"
                BorderBrush="{StaticResource Success}" Background="{StaticResource Surface2}" Padding="13,11" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE930;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{StaticResource Success}" Margin="0,1,8,0" />
                    <TextBlock Grid.Column="1" Text="Your own Google key is ready — fast and not shared with anyone."
                               Foreground="{StaticResource Success}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                </Grid>
                <TextBlock x:Name="KeyFileText" Style="{StaticResource Caption}" Margin="20,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="18,6,0,0">
                    <Button x:Name="TesterButton" Content="Add me as a tester" Style="{StaticResource Ghost}"
                            Padding="0,2" Margin="0,0,16,0" Click="OpenTesters" />
                    <Button Content="Use a different key file…" Style="{StaticResource Ghost}" Padding="0,2" Click="LoadKey" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Button x:Name="QuickButton" Style="{StaticResource Primary}" HorizontalAlignment="Stretch"
                Padding="14,11" Click="QuickConnect" Margin="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="Sign in with Google" FontSize="14" />
            </StackPanel>
        </Button>
        <TextBlock x:Name="ModeText" Style="{StaticResource Caption}" Margin="0,8,0,0" Foreground="{StaticResource Dim}" />

        <!-- Shown when no key file exists yet -->
        <Border x:Name="GetKeyBox" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                Background="{StaticResource Surface}" Padding="13,11" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"
                           Text="Getting slow drives or “rate limited”? Use your own free Google key (one time)." />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,9" TextWrapping="Wrap"
                           Text="In Google Cloud: Clients → your Desktop client → Download JSON (or create one: Create client → Desktop app). Aveniq finds the file in Downloads automatically." />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Open Google Cloud" Click="OpenConsole" />
                    <Button Content="I downloaded it — find key" Click="FindKey" />
                    <Button Content="Choose file…" Style="{StaticResource Ghost}" Click="LoadKey" />
                </StackPanel>
            </StackPanel>
        </Border>

        <CheckBox x:Name="ReadOnlyBox" Margin="0,15,0,0"
                  Content="Read-only access (protects Drive files; no writing or installing on it)" />

        <CheckBox x:Name="AdvancedBox" Margin="0,8,0,0" Content="Enter a key manually"
                  Checked="AdvancedChanged" Unchecked="AdvancedChanged" />
        <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="26,10,0,0">
            <TextBlock Text="OAuth client ID" Style="{StaticResource Label}" />
            <TextBox x:Name="ClientIdBox" Margin="0,0,0,10" />
            <TextBlock Text="OAuth client secret" Style="{StaticResource Label}" />
            <PasswordBox x:Name="SecretBox" Margin="0,0,0,10" />
            <TextBlock Text="Root folder ID (optional — limit access to one Drive folder)" Style="{StaticResource Label}" />
            <TextBox x:Name="RootBox" Margin="0,0,0,10" />
            <Button x:Name="ConnectButton" Style="{StaticResource Primary}" Content="Connect with this key"
                    HorizontalAlignment="Left" Click="Connect" />
        </StackPanel>

        <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="0,14,0,0" Foreground="{StaticResource AccentHover}"
                   MaxHeight="120" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
        <Button x:Name="FixButton" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,10,0,0"
                Visibility="Collapsed" Click="OpenFix" />
        <ProgressBar x:Name="Progress" IsIndeterminate="True" Margin="0,10,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="Cancel" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
