<UserControl x:Class="Aveniq.Desktop.Views.AcceleratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Aveniq.Desktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,20">

            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,13">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Predictive prefetching"
                              IsChecked="{Binding PredictionEnabled}" VerticalAlignment="Center" Width="214" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource Cyan}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Session}" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Session}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Policy}" Style="{StaticResource Caption}" Margin="0,4,16,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,13">
                <StackPanel>
                    <TextBlock Text="This session" Style="{StaticResource H2}" Margin="0,0,0,9" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Cache hits" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Hits}" Style="{StaticResource Metric}" Foreground="{StaticResource Cyan}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="Cache misses" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding Misses}" Style="{StaticResource Metric}" Foreground="{StaticResource Amber}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="14,0,0,0">
                            <TextBlock Text="Hit rate" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding HitRate}" Style="{StaticResource Metric}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="14,0,0,0">
                            <TextBlock Text="Average read wait" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding AvgWait}" Style="{StaticResource Metric}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="14,0,0,0">
                            <TextBlock Text="Longest stall" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding LongestStall}" Style="{StaticResource Metric}" />
                            <TextBlock Text="{Binding Stalls}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Stalls}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Hit rate per second" Style="{StaticResource H2}" Margin="0,0,0,1" />
                        <TextBlock Text="Application reads only" Style="{StaticResource Caption}" />
                        <c:Sparkline Values="{Binding HitHistory}" MaxValue="1" Height="100" Stroke="{StaticResource Cyan}"
                                     EmptyText="Play a game to see hits and misses" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Average read wait" Style="{StaticResource H2}" Margin="0,0,0,1" />
                        <TextBlock Text="Milliseconds" Style="{StaticResource Caption}" />
                        <c:Sparkline Values="{Binding WaitHistory}" Height="100" Stroke="{StaticResource Amber}"
                                     EmptyText="Waits appear once the game reads data" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Prefetch queue" Style="{StaticResource H2}" Margin="0,0,0,1" />
                        <TextBlock Text="Speculative reads waiting or in flight" Style="{StaticResource Caption}" />
                        <c:Sparkline Values="{Binding QueueHistory}" Height="100" Stroke="{StaticResource AccentHover}"
                                     EmptyText="Nothing queued" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.55*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Prediction activity" Style="{StaticResource H2}" Margin="0,0,0,2" />
                        <TextBlock Text="Scheduler decisions and predictor outcomes for this session."
                                   Style="{StaticResource Caption}" Margin="0,0,0,7" />
                        <ItemsControl ItemsSource="{Binding Queue}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="11.5"
                                                       Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                                            <TextBlock Text="{Binding Key}" FontSize="11.5" Foreground="{StaticResource Muted}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Prefetch accuracy" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="1" Text="{Binding Accuracy}" FontSize="11.5" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Useful prefetch" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="1" Text="{Binding Useful}" FontSize="11.5" Foreground="{StaticResource Success}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Wasted prefetch" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="1" Text="{Binding Wasted}" FontSize="11.5" Foreground="{StaticResource Warning}" />
                        </Grid>

                        <TextBlock Text="Predictors" Style="{StaticResource H2}" Margin="0,14,0,2" />
                        <TextBlock Text="No active game session." Style="{StaticResource Caption}"
                                   Visibility="{Binding Predictors.Count, Converter={StaticResource NotVis}}" />
                        <ItemsControl ItemsSource="{Binding Predictors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,7">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding State}" FontSize="10.5"
                                                       Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Caption}" FontSize="10.5">
                                            <Run Text="Issued " /><Run Text="{Binding Issued}" /><Run Text=" · useful " /><Run Text="{Binding Useful}" /><Run Text=" · wasted " /><Run Text="{Binding Wasted}" /><Run Text=" · accuracy " /><Run Text="{Binding Accuracy}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Live game reads" Style="{StaticResource H2}" Margin="0,0,0,2" />
                        <TextBlock Text="Application reads observed through rclone telemetry." Style="{StaticResource Caption}" Margin="0,0,0,8" />
                        <Border Style="{StaticResource EmptyState}" Padding="18,22"
                                Visibility="{Binding Reads.Count, Converter={StaticResource NotVis}}">
                            <TextBlock Text="No game reads yet. Press Play in the Game Library to watch them here."
                                       Style="{StaticResource EmptyText}" />
                        </Border>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="138" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TIME" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="1" Text="CACHE" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="2" Text="WAIT" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="3" Text="RANGE" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="4" Text="PATH" Style="{StaticResource Label}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Reads}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="138" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Dim}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Result}" FontSize="10.5"
                                                       Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Wait}" FontSize="10.5" />
                                            <TextBlock Grid.Column="3" Text="{Binding Range}" FontSize="10.5" Foreground="{StaticResource Muted}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4" Text="{Binding Path}" FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Style="{StaticResource Caption}" Margin="2,0,8,0"
                       Text="Hits and misses are rclone's cache verdict for each read; wait times are measured between the read request and its completion. Aveniq's own prefetch reads are excluded from these figures." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
