<UserControl x:Class="Aveniq.Desktop.Views.CloudDrivesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,20">

            <DockPanel Margin="0,0,0,5">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Drives.Count, StringFormat={}{0} configured}"
                           Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <TextBlock Text="Virtual drives" Style="{StaticResource H2}" Margin="0" />
            </DockPanel>

            <Border Style="{StaticResource EmptyState}" Margin="0,0,0,14"
                    Visibility="{Binding Drives.Count, Converter={StaticResource NotVis}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,6">
                    <TextBlock Text="&#xE88E;" FontFamily="{StaticResource IconFont}" FontSize="24"
                               Foreground="{StaticResource AccentHover}" HorizontalAlignment="Center" />
                    <TextBlock Text="No virtual drives yet" Style="{StaticResource EmptyTitle}" Margin="0,10,0,0" />
                    <TextBlock Text="Connect a cloud account, then add the folder you want to see in File Explorer."
                               Style="{StaticResource EmptyText}" MaxWidth="390" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button Style="{StaticResource Primary}" Command="{Binding ConnectGoogleDriveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="Sign in with Google Drive" />
                            </StackPanel>
                        </Button>
                        <Button Content="Add virtual drive" Command="{Binding AddDriveCommand}" CommandParameter="{x:Null}" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                     Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RowItem}"
                     Margin="0,0,0,14" MaxHeight="310">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource Surface2}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,13,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Letter}" FontFamily="{StaticResource DisplayFont}" FontSize="13"
                                           FontWeight="SemiBold" Foreground="{StaticResource AccentHover}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Pill}" Margin="9,0,0,0"
                                            BorderBrush="{Binding Tone, Converter={StaticResource Tone}}">
                                        <TextBlock Text="{Binding State}" FontSize="10.5"
                                                   Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Remote}" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                           Foreground="{StaticResource Muted}" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Remote}" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Content="Open" Padding="9,4" MinHeight="27" Margin="0,0,5,0"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" Visibility="{Binding IsMounted, Converter={StaticResource Vis}}" />
                                <Button Content="Refresh" Padding="9,4" MinHeight="27" Margin="0,0,5,0"
                                        ToolTip="Forget the directory cache and revalidate cloud files on next access."
                                        Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" Visibility="{Binding IsMounted, Converter={StaticResource Vis}}" />
                                <Button Content="Unmount" Padding="9,4" MinHeight="27" Margin="0,0,5,0"
                                        Command="{Binding DataContext.UnmountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" Visibility="{Binding IsMounted, Converter={StaticResource Vis}}" />
                                <Button Content="Mount" Style="{StaticResource Primary}" Padding="10,4" MinHeight="27" Margin="0,0,5,0"
                                        Command="{Binding DataContext.MountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" Visibility="{Binding IsMounted, Converter={StaticResource NotVis}}" />
                                <Button Content="Remove" Style="{StaticResource DangerButton}" Padding="9,4" MinHeight="27" Margin="0"
                                        Command="{Binding DataContext.RemoveDriveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Connected accounts" Style="{StaticResource H2}" Margin="0,0,0,2" />
                        <TextBlock Text="Accounts discovered from the local rclone configuration."
                                   Style="{StaticResource Caption}" Margin="0,0,0,6" />
                        <TextBlock Text="None yet. Connect a provider from the header." Style="{StaticResource Caption}"
                                   Visibility="{Binding Accounts.Count, Converter={StaticResource NotVis}}" Margin="0,4,0,6" />
                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource Surface3}"
                                                    Margin="0,0,9,0" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                           Foreground="{StaticResource AccentHover}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ProviderName}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Add drive" Style="{StaticResource Ghost}" Padding="7,3" MinHeight="24"
                                                        Command="{Binding DataContext.AddDriveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Remote}" />
                                                <Button Content="Disconnect" Style="{StaticResource Ghost}" Padding="7,3" MinHeight="24" Margin="0"
                                                        Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Remote}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Cloud providers" Style="{StaticResource H2}" Margin="0,0,0,2" />
                        <TextBlock Text="What Aveniq can mount through rclone, and how well it has been verified."
                                   Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding ProviderRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Notes}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Top"
                                                    BorderBrush="{Binding Tone, Converter={StaticResource Tone}}">
                                                <TextBlock Text="{Binding Support}" FontSize="10.5"
                                                           Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
