<UserControl x:Class="Aveniq.Desktop.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,20">

            <Border Style="{StaticResource Panel}" Margin="0,0,0,12" Padding="12,9">
                <DockPanel>
                    <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource Cyan}" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Dependencies" Style="{StaticResource H2}" Margin="0,0,0,2" />
                        <TextBlock Text="Everything Aveniq needs for mounting, caching and launching." Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Dependencies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,5,11,0"
                                                     Fill="{Binding Tone, Converter={StaticResource Tone}}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Key}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Value}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Recovery suggestions" Style="{StaticResource H2}" Margin="0,0,0,2" />
                        <TextBlock Text="Only actions that match a real detected condition are listed." Style="{StaticResource Caption}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface2}" BorderBrush="{Binding Tone, Converter={StaticResource Tone}}"
                                            BorderThickness="1" CornerRadius="7" Padding="11,9" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="6" Height="6" Fill="{Binding Tone, Converter={StaticResource Tone}}"
                                                     VerticalAlignment="Top" Margin="0,5,9,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                                                <TextBlock Text="{Binding Value}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" Content="Warnings and errors only"
                                  IsChecked="{Binding ErrorsOnly}" Width="214" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Application log" Style="{StaticResource H2}" Margin="0,0,0,1" />
                            <TextBlock Text="Newest entries first. Diagnostics reports redact tokens, secrets and passwords." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Nothing to show." Style="{StaticResource Caption}" Margin="0,6,0,4"
                               Visibility="{Binding Logs.Count, Converter={StaticResource NotVis}}" />

                    <Grid Margin="0,2,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TIME" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="1" Text="LEVEL" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="2" Text="SOURCE" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="3" Text="MESSAGE" Style="{StaticResource Label}" />
                    </Grid>
                    <ScrollViewer MaxHeight="310" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Logs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Dim}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="10.5"
                                                       Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Source}" FontSize="10.5" Foreground="{StaticResource Muted}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="10.5" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="rclone mount log" Style="{StaticResource H2}" Margin="0,0,0,1" />
                    <TextBlock Text="Errors and notices from every running mount." Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RcloneLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                               TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
