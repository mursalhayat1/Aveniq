<UserControl x:Class="Aveniq.Desktop.Views.SmartCacheView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,20">

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="Storage budget" Style="{StaticResource H2}" Margin="0,0,0,2" />
                        <TextBlock Text="Limits apply to every mounted drive." Style="{StaticResource Caption}" Margin="0,0,0,8" />

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Cache budget" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="Applies to all drives, in GB." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding BudgetGb, UpdateSourceTrigger=PropertyChanged}" Width="62" Margin="0,0,7,0" />
                                    <ItemsControl ItemsSource="{Binding Presets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Segment}" Content="{Binding StringFormat={}{0}}"
                                                        Command="{Binding DataContext.PresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Kept free for Windows" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="The cache pauses before it eats into this reserve." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding ReserveGb, UpdateSourceTrigger=PropertyChanged}" Width="62" />
                                    <TextBlock Text="GB" Style="{StaticResource Caption}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Remove data unused for" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="Only cached copies expire; cloud files are untouched." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding MaxAgeDays, UpdateSourceTrigger=PropertyChanged}" Width="62" />
                                    <TextBlock Text="days" Style="{StaticResource Caption}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Cache location" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CacheRoot}" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                               Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding CacheRoot}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Browse" Command="{Binding ChooseLocationCommand}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding VolumeInfo}" Style="{StaticResource Caption}" Margin="0,8,0,10" />
                        <WrapPanel>
                            <Button Style="{StaticResource Primary}" Content="Apply" Command="{Binding ApplyCommand}" />
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                            <Button Content="Clear unmounted caches…" Style="{StaticResource DangerButton}" Command="{Binding ClearCacheCommand}" Margin="0" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Right" Text="Live on disk" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBlock Text="Usage" Style="{StaticResource H2}" Margin="0" />
                        </DockPanel>
                        <TextBlock Text="{Binding UsedSummary}" Style="{StaticResource MetricLarge}" />
                        <TextBlock Text="{Binding BudgetSummary}" Style="{StaticResource Caption}" Margin="0,1,0,9" />
                        <ProgressBar Value="{Binding UsedFraction}" Maximum="1" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Usage}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding Tone, Converter={StaticResource Tone}}" />
                                            <TextBlock Text="{Binding Key}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,10,0" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Effective}" Foreground="{StaticResource AccentHover}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Pinned files" Style="{StaticResource H2}" Margin="0,0,0,1" />
                                <TextBlock Text="Kept most recently used, so rclone evicts them last." Style="{StaticResource Caption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="Pin selected" Command="{Binding PinCommand}" IsEnabled="{Binding HasSelectedFile}" Padding="9,4" MinHeight="27" />
                                <Button Content="Touch now" Command="{Binding WarmPinnedCommand}" Padding="9,4" MinHeight="27" Margin="0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="No pinned files yet. Select a cached file below and pin it."
                                   Style="{StaticResource Caption}" Margin="0,4,0,4"
                                   Visibility="{Binding Pinned.Count, Converter={StaticResource NotVis}}" />
                        <ItemsControl ItemsSource="{Binding Pinned}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,3">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Unpin" Style="{StaticResource Ghost}" Padding="6,2" MinHeight="22"
                                                    Command="{Binding DataContext.UnpinCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="What gets removed" Style="{StaticResource H2}" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Eviction is handled by rclone: least-recently-used files are removed when the budget or the protected free space is exceeded, and data unused for the maximum age expires. Only cached copies are removed — never cloud originals, never files outside the Aveniq cache folder, never save games." />
                        <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource Warning}" TextWrapping="Wrap"
                                               FontSize="10.5" Margin="0,0,0,5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="16,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Files.Count, StringFormat={}{0} cached files}"
                                   Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Cached files" Style="{StaticResource H2}" Margin="0,0,0,1" />
                            <TextBlock Text="Most recently used first. Select a row to pin it." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource EmptyState}" Margin="0,8,0,8" Padding="18,22"
                            Visibility="{Binding Files.Count, Converter={StaticResource NotVis}}">
                        <TextBlock Text="No cached files yet. Play a game or open a file from a mounted drive."
                                   Style="{StaticResource EmptyText}" />
                    </Border>

                    <Grid Margin="0,6,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DRIVE" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="1" Text="FILE" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="2" Text="DOWNLOADED" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="3" Text="ON DISK" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="4" Text="LOGICAL" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="5" Text="LAST USED" Style="{StaticResource Label}" />
                    </Grid>

                    <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Background="Transparent"
                             BorderThickness="0" MaxHeight="420" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1" Padding="0,5">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource HoverWash}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource AccentFaint}" />
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Mount}" Foreground="{StaticResource Muted}" FontSize="10.5"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Mount}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Cached}" FontSize="10.5" />
                                        <ProgressBar Value="{Binding Fraction}" Maximum="1" Height="3" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Physical}" FontSize="10.5" />
                                    <TextBlock Grid.Column="4" Text="{Binding Logical}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="5" Text="{Binding LastAccess}" FontSize="10.5" Foreground="{StaticResource Muted}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding LastAccess}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
