<Window x:Class="Aveniq.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Aveniq.Desktop.ViewModels"
        xmlns:v="clr-namespace:Aveniq.Desktop.Views"
        Title="Aveniq" Height="860" Width="1380" MinWidth="1100" MinHeight="680"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" Icon="Assets/aveniq.ico"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CloudDrivesViewModel}"><v:CloudDrivesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameLibraryViewModel}"><v:GameLibraryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AcceleratorViewModel}"><v:AcceleratorView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SmartCacheViewModel}"><v:SmartCacheView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PerformanceViewModel}"><v:PerformanceView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><v:DiagnosticsView /></DataTemplate>

        <!-- Header actions: each template receives the selected page view model. -->
        <DataTemplate x:Key="HeaderEmpty">
            <StackPanel Orientation="Horizontal" />
        </DataTemplate>
        <DataTemplate x:Key="HeaderDashboard">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource HeaderButton}" Content="Cloud drives"
                        Command="{Binding GoCommand}" CommandParameter="Cloud Drives" />
                <Button Style="{StaticResource HeaderPrimary}" Content="Game library"
                        Command="{Binding GoCommand}" CommandParameter="Game Library" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="HeaderCloudDrives">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource HeaderButton}" Content="TeraBox" Command="{Binding ConnectTeraBoxCommand}" />
                <Button Style="{StaticResource HeaderButton}" Content="Dropbox" Command="{Binding ConnectDropboxCommand}" />
                <Button Style="{StaticResource HeaderButton}" Content="Add virtual drive"
                        Command="{Binding AddDriveCommand}" CommandParameter="{x:Null}" />
                <Button Style="{StaticResource HeaderPrimary}" Command="{Binding ConnectGoogleDriveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Sign in with Google" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="HeaderGameLibrary">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource HeaderPrimary}" Command="{Binding AddGameCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Add game" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="HeaderSmartCache">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource HeaderButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="HeaderSettings">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource HeaderButton}" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
                <Button Style="{StaticResource HeaderPrimary}" Content="Save settings" Command="{Binding SaveCommand}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="HeaderDiagnostics">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource HeaderButton}" Content="Open log folder" Command="{Binding OpenLogsCommand}" />
                <Button Style="{StaticResource HeaderButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Style="{StaticResource HeaderPrimary}" Content="Export report" Command="{Binding ExportCommand}"
                        ToolTip="Export a sanitized diagnostics report (tokens and secrets removed)." />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="192" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Navigation rail -->
        <Border Grid.RowSpan="2" Background="{StaticResource Rail}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="18,17,14,16" Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentSoft}"
                            BorderBrush="{StaticResource Accent}" BorderThickness="1">
                        <Image Source="Assets/aveniq.ico" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Aveniq" FontFamily="{StaticResource DisplayFont}" FontSize="15.5" FontWeight="Bold" />
                        <TextBlock Text="Cloud to SSD" FontSize="9.5" Foreground="{StaticResource Dim}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
                    <Border Style="{StaticResource Hairline}" Margin="20,0,20,8" />
                    <ListBox ItemsSource="{Binding UtilityPages}" SelectedItem="{Binding UtilitySelected, Mode=TwoWay}"
                             Style="{StaticResource NavList}" Margin="0,0,0,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="13.5" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Dim}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentHover}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <ListBox ItemsSource="{Binding PrimaryPages}" SelectedItem="{Binding PrimarySelected, Mode=TwoWay}"
                         Style="{StaticResource NavList}" Margin="0,2,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="13.5" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Dim}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentHover}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page column -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <!-- Page header -->
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="{StaticResource Bg}">
            <Grid Margin="26,14,26,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Selected.Title}" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,1,0,0"
                                Visibility="{Binding Selected.Busy, Converter={StaticResource Vis}}">
                        <ProgressBar Style="{StaticResource Spinner}" />
                        <TextBlock Text="Working" FontSize="11" Foreground="{StaticResource Muted}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <ContentControl Grid.Column="1" Content="{Binding Selected}" VerticalAlignment="Center">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource HeaderEmpty}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Selected.Title}" Value="Dashboard">
                                    <Setter Property="ContentTemplate" Value="{StaticResource HeaderDashboard}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Selected.Title}" Value="Cloud Drives">
                                    <Setter Property="ContentTemplate" Value="{StaticResource HeaderCloudDrives}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Selected.Title}" Value="Game Library">
                                    <Setter Property="ContentTemplate" Value="{StaticResource HeaderGameLibrary}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Selected.Title}" Value="Smart Cache">
                                    <Setter Property="ContentTemplate" Value="{StaticResource HeaderSmartCache}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Selected.Title}" Value="Settings">
                                    <Setter Property="ContentTemplate" Value="{StaticResource HeaderSettings}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Selected.Title}" Value="Diagnostics">
                                    <Setter Property="ContentTemplate" Value="{StaticResource HeaderDiagnostics}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Border>

        <!-- Message ribbon -->
        <Border Grid.Row="1" Margin="26,0,26,10" Padding="12,8" CornerRadius="8"
                Background="{StaticResource Surface}" BorderThickness="1"
                BorderBrush="{Binding Selected.MessageTone, Converter={StaticResource Tone}}"
                Visibility="{Binding Selected.Message, Converter={StaticResource Vis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,10,0"
                         Fill="{Binding Selected.MessageTone, Converter={StaticResource Tone}}" />
                <TextBlock Grid.Column="1" Text="{Binding Selected.Message}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource Text}" />
            </Grid>
        </Border>

        <!-- Page -->
        <ContentControl Grid.Row="2" Content="{Binding Selected}" Margin="26,0,26,10" Focusable="False" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Rail}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Cyan}" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DrivesStatus}" Foreground="{StaticResource Muted}" FontSize="11"
                               ToolTip="{Binding DrivesDetail}" ToolTipService.ShowDuration="20000" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding RateStatus, Converter={StaticResource Vis}}">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentHover}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RateStatus}" Foreground="{StaticResource Muted}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" Visibility="{Binding EngineStatus, Converter={StaticResource Vis}}">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource Cyan}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EngineStatus}" Foreground="{StaticResource Muted}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" Visibility="{Binding GameStatus, Converter={StaticResource Vis}}">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource Success}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GameStatus}" Foreground="{StaticResource Text}" FontSize="11" />
                    </StackPanel>
                    <Border Width="1" Height="12" Background="{StaticResource BorderBrush}" Margin="16,0" />
                    <TextBlock Text="{Binding Version}" Foreground="{StaticResource Dim}" FontSize="10.5" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
